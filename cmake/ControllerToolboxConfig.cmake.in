@PACKAGE_INIT@

# Propagate Eigen3 dependency so consumers don't need to find it themselves.
# find_dependency lives in this module - it is not a built-in command.
include(CMakeFindDependencyMacro)
find_dependency(Eigen3 NO_MODULE)

include("${CMAKE_CURRENT_LIST_DIR}/ControllerToolboxTargets.cmake")

check_required_components(ControllerToolbox)
